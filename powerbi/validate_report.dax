        TREATAS({"Unknown"}, 'DimHora'[precipitation_category])
    )
    )
RETURN
    ADDCOLUMNS(
        Results,
        "Pass",
        [Trips] = [Expected Trips]
            && ABS([Recorded total USD] - [Expected Recorded total USD]) <= 0.01
            && [Period hours] = [Expected Period hours]
            && ABS([Trips per hour] - [Expected Trips per hour]) <= 0.0000001
            && ABS([Average total USD] - [Expected Average total USD]) <= 0.0000001
            && [Airport fee trips] = [Expected Airport fee trips]
            && [Airport pickups] = [Expected Airport pickups]
    )
ORDER BY [Scenario]
